# Example graft.exs — copy to `graft.exs` at your workspace root and edit.
#
# `name` matches the OTP app atom; `path` is relative to `root`.
# `origin` is optional and lets `graft.validate --quick` / `graft.status`
# report remote mismatches. The file must be literal data.

%{
  root: ".",
  siblings: [
    %{name: :req_llm, path: "req_llm", origin: "https://github.com/agentjido/req_llm.git"},
    %{name: :jido, path: "jido"},
    %{name: :jido_ai, path: "jido_ai"},
    %{name: :jido_chat, path: "jido_chat"}
  ]
}
